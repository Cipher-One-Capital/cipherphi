# Copy to .env.local. Every secret here is a TESTNET key from ../.secrets.json,
# written by ../scripts/deploy.mjs. No mainnet key ever belongs in this file.

# Privy app ID (public by design). Add the app's origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Sponsors visitor accounts, gives them test USDC, pays their fees and renews the pool's storage lease.
TREASURY_SECRET=
# The only address the pool lets submit a payout.
DISTRIBUTOR_SECRET=
# Two of the three eligibility signers. The third is deliberately not here.
AUTHORITY_SECRET_0=
AUTHORITY_SECRET_1=
